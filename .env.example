# Server process only. Fixture mode is the default and makes no provider calls.
# fixture | live (needs CMC_API_KEY) | keyless (no key of any kind is read or sent).
# To turn the keyless demo off, this one line: CMC_MODE=fixture
# Keyless caveat: keyless commercial terms are unstated; keep it to the demo
# until reviewed.
CMC_MODE=fixture
CMC_API_KEY=
CMC_VERIFIED_PLAN=basic
# Persistent local per-calendar-month ceiling, in addition to live account headroom.
CMC_DEMO_CREDIT_LIMIT=20
DEMO_API_PORT=8788
DEMO_WEB_PORT=5187
